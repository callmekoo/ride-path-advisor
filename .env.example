# Скопируйте в .env (он не попадает в git) и заполните.
# Разбор текстовых запросов: любой OpenAI-совместимый API.
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=model-name
LLM_API_KEY=
# Прокси только для обращений к модели: http://, https:// или socks5://. Пусто — напрямую.
LLM_PROXY_URL=
# Сколько секунд ждать ответа модели.
LLM_TIMEOUT_S=60
